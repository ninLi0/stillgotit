# Settings for local development. Copy this file to .env, which Bun reads and git ignores.
# The database name is part of the URI, as on the 6.1040 Apps platform.
MONGODB_URI=mongodb://127.0.0.1:27017/stillgotit?directConnection=true
# Tests use this server. Each test file creates its own stillgotit_test_<id> database and drops it when it finishes.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/?directConnection=true
# The Commons sign-in provider. Keep it fixed for an existing account database.
COMMONS_ORIGIN=https://class.mit-sdg.dev
# The address people open. bun run preview sets it to http://127.0.0.1:3000; dev:server sets it to the Vite address.
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Gemini API key from Google AI Studio. Never commit a real key.
GEMINI_API_KEY=
# Optional. The default is gemini-3.8-flash.
GEMINI_MODEL=
# Optional. The model that transcribes imported recordings and videos; without it, GEMINI_MODEL is used.
GEMINI_TRANSCRIBE_MODEL=
# Optional S3 storage for uploaded files. Without these, files are kept in .data/files.
# S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY= S3_REGION= S3_BUCKET= S3_ENDPOINT=
