# Defaults for local development. Bun reads .env if you copy this file there.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=stillgotit
# Tests use a fresh database per run. They ignore MONGODB_DATABASE.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
# Commons provider settings. Keep this provider fixed for an existing account database.
COMMONS_ORIGIN=https://class.mit-sdg.dev
# Build the Vue page, run bun run start, and open this exact origin.
APP_ORIGIN=http://localhost:5173
PORT=5173
